#!/usr/bin/env perl

# Reload the configuration while a DNS query for a hostname backend is in
# flight. The pending query used to reference the table backend's address,
# which the reload freed, leading to a use-after-free in resolv_cb().
#
# This needs to run a fake name server on port 53, so it is skipped unless
# run as root.

use strict;
use warnings;
use File::Basename;
use lib dirname (__FILE__);
use TestUtils;
use TestHTTPD;
use File::Temp;
use IO::Socket::INET;
use Socket;

my $dns_ip = '127.0.0.9';
my $dns_delay = 2;

sub proxy {
    my $config = shift;

    exec(@_, '../src/sniproxy', '-f', '-c', $config);
}

# Answer every A query with 127.0.0.1, after a delay
sub slow_dns_server($) {
    my $server = shift;

    $SIG{CHLD} = 'IGNORE';

    while (1) {
        my $query;
        my $peer = $server->recv($query, 512);
        next unless defined $peer && length($query) > 12;

        my $pid = fork();
        next if $pid;
        die "fork: $!" unless defined $pid;

        sleep $dns_delay;

        # Skip over the question name
        my $pos = 12;
        while ($pos < length($query) && (my $len = ord(substr($query, $pos, 1))) != 0) {
            $pos += $len + 1;
        }
        my $qtype = unpack('n', substr($query, $pos + 1, 2));
        my $question = substr($query, 12, $pos + 5 - 12);

        my $answer = '';
        my $ancount = 0;
        if ($qtype == 1) {
            $answer = pack('n n n N n', 0xc00c, 1, 1, 60, 4) . inet_aton('127.0.0.1');
            $ancount = 1;
        }
        my $response = substr($query, 0, 2) . pack('n n n n n', 0x8180, 1, $ancount, 0, 0) .
                       $question . $answer;
        $server->send($response, 0, $peer);
        exit 0;
    }
}

sub client($) {
    my $port = shift;

    my $socket = IO::Socket::INET->new(PeerAddr => '127.0.0.1',
                                       PeerPort => $port,
                                       Proto => 'tcp',
                                       Type => SOCK_STREAM)
        or die "couldn't connect $!";

    $socket->send("GET / HTTP/1.1\r\nHost: slow.example\r\n\r\n");

    my $response = '';
    while (1) {
        my $buffer;
        my $result = $socket->recv($buffer, 4096);
        last unless defined $result && length($buffer);
        $response .= $buffer;
    }
    $socket->close();

    exit($response =~ m/\AHTTP\/1\.1 200 / ? 0 : 1);
}

sub main {
    my $proxy_port = $ENV{SNI_PROXY_PORT} || 8080;
    my $httpd_port = $ENV{TEST_HTTPD_PORT} || 8081;

    if ($> != 0) {
        print "Not running as root, skipping\n";
        exit 77;
    }

    my $dns = IO::Socket::INET->new(LocalAddr => $dns_ip,
                                    LocalPort => 53,
                                    Proto => 'udp');
    unless ($dns) {
        print "Unable to bind $dns_ip:53, skipping\n";
        exit 77;
    }

    # Readable by the unprivileged user sniproxy runs as after dropping
    # privileges, even when root's TMPDIR is private
    my $dir = world_readable_tempdir();
    my ($fh, $config) = File::Temp::tempfile(DIR => $dir);
    chmod(0644, $config);
    my $error_log = "$dir/error.log";
    open(my $log_fh, '>', $error_log) or die "open: $!";
    close($log_fh);
    chmod(0666, $error_log);
    print $fh <<END;
error_log {
    filename $error_log
    priority notice
}

resolver {
    nameserver $dns_ip
    mode ipv4_only
}

listen 127.0.0.1 $proxy_port {
    proto http
    table backends
}

table backends {
    ^slow\\.example\$ slow.example $httpd_port
}
END
    close($fh);

    start_child('server', \&slow_dns_server, $dns);
    $dns->close();
    my $proxy_pid = start_child('server', \&proxy, $config, @ARGV);
    start_child('server', \&TestHTTPD::httpd, port => $httpd_port);

    wait_for_port(port => $proxy_port);
    wait_for_port(port => $httpd_port);

    start_child('worker', \&client, $proxy_port);

    # The DNS query is now pending, reload while waiting for the response
    sleep 1;
    kill 1, $proxy_pid;

    wait_for_type('worker');

    sleep 1;
    kill 15, $proxy_pid;
    sleep 1;

    unlink($config);

    reap_children();

    # Make sure the reload this test is about actually happened
    open($log_fh, '<', $error_log) or die "open: $!";
    my $reloaded = grep { /reloading configuration/ } <$log_fh>;
    close($log_fh);
    unless ($reloaded) {
        print "Test failed: sniproxy didn't reload its configuration\n";
        exit 1;
    }
}

main();
