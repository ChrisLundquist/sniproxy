#!/usr/bin/env perl

# Verify listener and table settings which are not part of the listener
# address are applied when the configuration is reloaded (SIGHUP):
#  - a fallback address without a port inherits the listener port
#  - adding "proxy" to a fallback enables the PROXY header
#  - adding "proxy_protocol" to a table backend enables the PROXY header

use strict;
use warnings;
use File::Basename;
use lib dirname (__FILE__);
use TestUtils;
use TestHTTPD;
use File::Temp;
use IO::Socket::INET;

sub proxy {
    my $config = shift;

    exec(@_, '../src/sniproxy', '-f', '-c', $config);
}

sub write_config($$$$$$) {
    my ($filename, $proxy_port1, $proxy_port2, $proxy_port3, $httpd_port2, $use_proxy) = @_;
    my $fallback_proxy = $use_proxy ? ' proxy' : '';
    my $backend_proxy = $use_proxy ? ' proxy_protocol' : '';

    open(my $fh, '>', $filename)
        or die("open(): $!");

    print $fh <<END;
# Reload listener test configuration

listen 127.0.0.1 $proxy_port1 {
    proto http
    table nomatch
    # no port: inherit $proxy_port1 from the listener
    fallback 127.0.0.2
}

listen 127.0.0.1 $proxy_port2 {
    proto http
    table nomatch
    fallback 127.0.0.1:$httpd_port2$fallback_proxy
}

listen 127.0.0.1 $proxy_port3 {
    proto http
    table backends
}

table nomatch {
    ^nomatch\\.invalid\$ 127.0.0.1 1
}

table backends {
    localhost 127.0.0.1 $httpd_port2$backend_proxy
}
END

    close($fh);
}

sub worker($$$) {
    my ($hostname, $port, $requests) = @_;

    for (my $i = 0; $i < $requests; $i++) {
        system('curl',
                '-s', '-S',
                '--fail',
                '-H', "Host: $hostname",
                '-o', '/dev/null',
                "http://localhost:$port/");

        if ($? == -1) {
            die "failed to execute: $!\n";
        } elsif ($? & 127) {
            printf STDERR "child died with signal %d, %s coredump\n", ($? & 127), ($? & 128) ? 'with' : 'without';
            exit 255;
        } elsif ($? >> 8) {
            exit $? >> 8;
        }
    }
    # Success
    exit 0;
}

# Respond 200 only if the request was preceded by a PROXY v1 header
sub proxy_header_parser {
    my $sock = shift;
    my $status = 500;

    for (my $i = 0; my $line = $sock->getline(); $i++) {
        $status = 200 if $i == 0 && $line =~ m/\APROXY TCP4 127\.0\.0\.1 127\.0\.0\.1 \d+ \d+\r\n\z/;

        last if $line eq "\r\n";
    }

    return $status;
}

sub main {
    my $proxy_port1 = $ENV{SNI_PROXY_PORT} || 8080;
    my $proxy_port2 = $ENV{SNI_PROXY_PORT2} || 8081;
    my $proxy_port3 = $ENV{SNI_PROXY_PORT3} || 8082;
    my $httpd_port2 = $ENV{TEST_HTTPD_PORT2} || 8084;
    my $iterations = $ENV{ITERATIONS} || 3;

    # The fallback test needs a second loopback address to listen on the same
    # port as the proxy listener.
    my $probe = IO::Socket::INET->new(Listen => 1,
                                      LocalAddr => '127.0.0.2',
                                      LocalPort => $proxy_port1,
                                      Proto => 'tcp',
                                      ReuseAddr => 1);
    unless ($probe) {
        print "Unable to bind 127.0.0.2:$proxy_port1, skipping\n";
        exit 77;
    }
    $probe->close();

    my ($fh, $config) = File::Temp::tempfile();
    close($fh);
    chmod(0644, $config);
    write_config($config, $proxy_port1, $proxy_port2, $proxy_port3, $httpd_port2, 0);

    my $proxy_pid = start_child('server', \&proxy, $config, @ARGV);
    start_child('server', \&TestHTTPD::httpd, ip => '127.0.0.2', port => $proxy_port1);
    start_child('server', \&TestHTTPD::httpd, ip => '127.0.0.1', port => $httpd_port2,
                parser => \&proxy_header_parser);

    wait_for_port(port => $proxy_port1);
    wait_for_port(port => $proxy_port2);
    wait_for_port(port => $proxy_port3);
    wait_for_port(ip => '127.0.0.2', port => $proxy_port1);
    wait_for_port(ip => '127.0.0.1', port => $httpd_port2);

    # Fallback inheriting the listener port works before the reload
    start_child('worker', \&worker, 'example.com', $proxy_port1, $iterations);
    wait_for_type('worker');

    # Enable the PROXY header on the fallback and table backend and reload
    write_config($config, $proxy_port1, $proxy_port2, $proxy_port3, $httpd_port2, 1);
    kill 1, $proxy_pid;
    sleep 1;

    start_child('worker', \&worker, 'example.com', $proxy_port1, $iterations);
    start_child('worker', \&worker, 'example.com', $proxy_port2, $iterations);
    start_child('worker', \&worker, 'localhost', $proxy_port3, $iterations);
    wait_for_type('worker');

    # Reload a second time with an unchanged config, fallback should still
    # have its port
    kill 1, $proxy_pid;
    sleep 1;

    start_child('worker', \&worker, 'example.com', $proxy_port1, $iterations);
    wait_for_type('worker');

    sleep 1;

    kill 15, $proxy_pid;
    sleep 1;

    unlink($config);

    reap_children();
}

main();
