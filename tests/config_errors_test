#!/usr/bin/env perl

# Check configuration files are accepted or rejected as expected using
# config_test, which parses a configuration and prints it back.

use strict;
use warnings;
use File::Temp;

my @cases = (
    {
        name => 'listener without address',
        config => "listener {\n    protocol http\n}\n",
        valid => 0,
    },
    {
        name => 'unknown protocol',
        config => "listener 127.0.0.1:8443 {\n    protocol gopher\n}\n",
        valid => 0,
    },
    {
        name => 'extra listener argument',
        config => "listener 127.0.0.1:8443 8444 {\n    protocol tls\n}\n",
        valid => 0,
    },
    {
        name => 'unknown bad_requests action',
        config => "listener 127.0.0.1:8443 {\n    bad_requests drop\n}\n",
        valid => 0,
    },
    {
        name => 'proxy_protocol accepted for fallback',
        config => "listener 127.0.0.1:8443 {\n    fallback 192.0.2.1:443 proxy_protocol\n}\n" .
                  "table {\n    ^a\$ 192.0.2.1:443\n}\n",
        valid => 1,
        output => qr/^\tfallback 192\.0\.2\.1:443 proxy$/m,
    },
    {
        name => 'invalid regular expression',
        config => "table {\n    ^(unclosed 192.0.2.1:443\n}\n",
        valid => 0,
    },
    {
        name => 'table entry without address',
        config => "table {\n    ^a#comment 192.0.2.1:443\n}\n",
        valid => 0,
    },
    {
        name => 'one line table block keeps its entry',
        config => "table { ^example\\\\.com\$ 192.0.2.1:443 }\n",
        valid => 1,
        output => qr/^\t\^example\\\.com\$ 192\.0\.2\.1:443$/m,
    },
    {
        name => 'stray closing brace',
        config => "table {\n    ^a\$ 192.0.2.1:443\n}\n}\nnot_a_keyword\n",
        valid => 0,
    },
    {
        name => 'unclosed block',
        config => "table {\n    ^a\$ 192.0.2.1:443\n",
        valid => 0,
    },
    {
        name => 'final line without newline',
        config => "table {\n    ^a\$ 192.0.2.1:443\n}\npidfile /tmp/sniproxy.pid",
        valid => 1,
        output => qr/^pidfile \/tmp\/sniproxy\.pid$/m,
    },
    {
        name => 'IPv4 and IPv6 nameservers and search domains accepted',
        config => "resolver {\n    nameserver 192.0.2.53\n    nameserver 2001:db8::53\n" .
                  "    search one.example\n    search two.example\n}\n",
        valid => 1,
        output => qr/^\tnameserver 192\.0\.2\.53\n\tnameserver 2001:db8::53\n\tsearch one\.example\n\tsearch two\.example$/m,
    },
    {
        # udns can not use a port: it used to be dropped silently, with
        # queries going to 127.0.0.1:53 instead
        name => 'nameserver with port',
        config => "resolver {\n    nameserver 192.0.2.53:5353\n}\n",
        valid => 0,
    },
    {
        name => 'bracketed IPv6 nameserver with port',
        config => "resolver {\n    nameserver [2001:db8::53]:53\n}\n",
        valid => 0,
    },
    {
        name => 'unix socket nameserver',
        config => "resolver {\n    nameserver unix:/tmp/dns.sock\n}\n",
        valid => 0,
    },
    {
        name => 'hostname nameserver',
        config => "resolver {\n    nameserver dns.example\n}\n",
        valid => 0,
    },
    {
        name => 'six nameservers accepted',
        config => "resolver {\n" . join('', map { "    nameserver 192.0.2.$_\n" } 1..6) . "}\n",
        valid => 1,
        output => qr/^\tnameserver 192\.0\.2\.6$/m,
    },
    {
        # udns supports at most six, more used to be dropped silently
        name => 'seven nameservers',
        config => "resolver {\n" . join('', map { "    nameserver 192.0.2.$_\n" } 1..7) . "}\n",
        valid => 0,
    },
    {
        name => 'half_close_timeout is parsed',
        config => "listener 127.0.0.1:8443 {\n    half_close_timeout 5\n}\n" .
                  "table {\n    ^a\$ 192.0.2.1:443\n}\n",
        valid => 1,
        output => qr/^\thalf_close_timeout 5$/m,
    },
    {
        name => 'half_close_timeout 0 is kept',
        config => "listener 127.0.0.1:8443 {\n    half_close_timeout 0\n}\n" .
                  "table {\n    ^a\$ 192.0.2.1:443\n}\n",
        valid => 1,
        output => qr/^\thalf_close_timeout 0$/m,
    },
    {
        name => 'half_close_timeout defaults to 60',
        config => "listener 127.0.0.1:8443 {\n    protocol tls\n}\n" .
                  "table {\n    ^a\$ 192.0.2.1:443\n}\n",
        valid => 1,
        output => qr/^\thalf_close_timeout 60$/m,
    },
    {
        name => 'negative half_close_timeout',
        config => "listener 127.0.0.1:8443 {\n    half_close_timeout -1\n}\n",
        valid => 0,
    },
    {
        name => 'half_close_timeout with a unit',
        config => "listener 127.0.0.1:8443 {\n    half_close_timeout 60s\n}\n",
        valid => 0,
    },
);

my $failures = 0;

foreach my $case (@cases) {
    my $fh = File::Temp->new();
    print $fh $case->{'config'};
    close($fh);

    my $output = `./config_test $fh 2>&1`;
    my $status = $? >> 8;
    my $signal = $? & 127;

    my $ok;
    if ($case->{'valid'}) {
        $ok = $status == 0 && $signal == 0;
        $ok &&= $output =~ $case->{'output'} if $case->{'output'};
    } else {
        # Must be an orderly rejection, not a crash
        $ok = $status == 1 && $signal == 0 && $output =~ m/Failed to parse config/;
    }

    unless ($ok) {
        print "FAIL: $case->{'name'} (exit $status, signal $signal)\n$output\n";
        $failures++;
    }
}

exit($failures ? 1 : 0);
