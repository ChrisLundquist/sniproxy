#!/usr/bin/env perl

# Check configuration files are accepted or rejected as expected using
# config_test, which parses a configuration and prints it back.

use strict;
use warnings;
use File::Temp;

my @cases = (
    {
        name => 'listener without address',
        config => "listener {\n    protocol http\n}\n",
        valid => 0,
    },
    {
        name => 'unknown protocol',
        config => "listener 127.0.0.1:8443 {\n    protocol gopher\n}\n",
        valid => 0,
    },
    {
        name => 'extra listener argument',
        config => "listener 127.0.0.1:8443 8444 {\n    protocol tls\n}\n",
        valid => 0,
    },
);

my $failures = 0;

foreach my $case (@cases) {
    my $fh = File::Temp->new();
    print $fh $case->{'config'};
    close($fh);

    my $output = `./config_test $fh 2>&1`;
    my $status = $? >> 8;
    my $signal = $? & 127;

    my $ok;
    if ($case->{'valid'}) {
        $ok = $status == 0 && $signal == 0;
        $ok &&= $output =~ $case->{'output'} if $case->{'output'};
    } else {
        # Must be an orderly rejection, not a crash
        $ok = $status == 1 && $signal == 0 && $output =~ m/Failed to parse config/;
    }

    unless ($ok) {
        print "FAIL: $case->{'name'} (exit $status, signal $signal)\n$output\n";
        $failures++;
    }
}

exit($failures ? 1 : 0);
