#!/usr/bin/env perl

# Verify a request whose Host header arrives split across several TCP
# segments is routed on the complete hostname: sniproxy must wait for the
# rest of the line rather than use the part received so far (e.g. "exam"
# from "Host: exam" ... "ple.com").

use strict;
use warnings;
use File::Basename;
use lib dirname (__FILE__);
use TestUtils;
use TestHTTPD;
use File::Temp;
use IO::Socket::INET;
use Socket qw(IPPROTO_TCP TCP_NODELAY);

sub proxy {
    my $config = shift;

    exec(@_, '../src/sniproxy', '-f', '-c', $config);
}

sub make_split_host_config($$) {
    my $proxy_port = shift;
    my $httpd_port = shift;

    my ($fh, $filename) = File::Temp::tempfile();
    my ($unused, $logfile) = File::Temp::tempfile();

    # Only the complete hostname matches: a truncated one gets a 503
    print $fh <<END;
# split_host_test configuration

listen 127.0.0.1 $proxy_port {
    proto http

    access_log $logfile
}

table {
    ^example\\.com\$ 127.0.0.1 $httpd_port
}
END

    close ($fh);

    return $filename;
}

# Send the request in the given pieces, pausing between them so sniproxy
# receives and parses each piece on its own, and return the status line
sub split_request($@) {
    my $port = shift;
    my @pieces = @_;

    my $socket = IO::Socket::INET->new(PeerAddr => '127.0.0.1',
                                       PeerPort => $port,
                                       Proto => "tcp",
                                       Type => SOCK_STREAM,
                                       Timeout => 5)
        or die "couldn't connect $!";
    $socket->setsockopt(IPPROTO_TCP, TCP_NODELAY, 1);

    for (my $i = 0; $i < @pieces; $i++) {
        select(undef, undef, undef, 0.3) if $i > 0;
        $socket->syswrite($pieces[$i]) == length($pieces[$i])
            or die "short write: $!";
    }

    my $status = $socket->getline();
    $socket->close();

    return defined($status) ? $status : '';
}

sub worker($) {
    my $port = shift;

    local $SIG{ALRM} = sub { die "alarm\n" };
    alarm 30;

    my @splits = (
        # inside the hostname
        [ "GET / HTTP/1.1\r\nHost: exam", "ple.com\r\n\r\n" ],
        # inside the header name
        [ "GET / HTTP/1.1\r\nHo", "st: example.com\r\n\r\n" ],
        # between the CR and LF ending the Host line
        [ "GET / HTTP/1.1\r\nHost: example.com\r", "\n\r\n" ],
        # three pieces, the second still ending inside the hostname, after
        # another header and with a port
        [ "GET / HTTP/1.1\r\nUser-Agent: split_host_test\r\nHost: ex", "ample.co", "m:80\r\n\r\n" ],
        # Host line ending in a bare LF (TestHTTPD itself needs CRLF for the
        # request line and the blank line)
        [ "GET / HTTP/1.1\r\nHost: exa", "mple.com\n\r\n" ],
    );

    foreach my $pieces (@splits) {
        my $status = split_request($port, @$pieces);

        die "Unexpected response to " . join(' | ', map { s/\r/\\r/gr =~ s/\n/\\n/gr } @$pieces) . ": $status"
            unless $status =~ /\AHTTP\/1\.1 200 OK/;
    }

    exit(0);
}

sub main {
    my $proxy_port = $ENV{SNI_PROXY_PORT} || 8080;
    my $httpd_port = $ENV{TEST_HTTPD_PORT} || 8081;

    my $config = make_split_host_config($proxy_port, $httpd_port);
    my $proxy_pid = start_child('server', \&proxy, $config, @ARGV);
    my $httpd_pid = start_child('server', \&TestHTTPD::httpd, port => $httpd_port);

    # Wait for proxy to load and parse config
    wait_for_port(port => $httpd_port);
    wait_for_port(port => $proxy_port);

    start_child('worker', \&worker, $proxy_port);

    # Wait for all our children to finish
    wait_for_type('worker');

    # Orderly shutdown of the server
    kill 15, $proxy_pid;
    kill 15, $httpd_pid;
    sleep 1;

    # Delete our test configuration
    unlink($config);

    # Kill off any remaining children
    reap_children();
}

main();
